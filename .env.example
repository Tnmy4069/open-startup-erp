# Community App Branding & White-Label Config
# Copy this file to .env and customize the values for your organization

NEXT_PUBLIC_APP_NAME="Apthex"
NEXT_PUBLIC_APP_SHORT_NAME="Aptex"
NEXT_PUBLIC_APP_DESCRIPTION="Aptex Operating System"
NEXT_PUBLIC_APP_LOGO_URL="/apthex-logo-nobg.png"
NEXT_PUBLIC_APP_ICON_URL="/favicon.ico"
NEXT_PUBLIC_FAVICON_URL="/favicon.ico"
NEXT_PUBLIC_THEME_COLOR="#ff0000ff"
NEXT_PUBLIC_CONTACT_EMAIL="tanmay@cyberx.org.in"
NEXT_PUBLIC_ORGANIZATION_DOMAIN="apthex.com"

# PWA Settings & Customizations
NEXT_PUBLIC_PWA_NAME="Apthex"
NEXT_PUBLIC_PWA_SHORT_NAME="Aptex"
NEXT_PUBLIC_PWA_DESCRIPTION="Aptex Operating System"
NEXT_PUBLIC_PWA_START_URL="/"
NEXT_PUBLIC_PWA_DISPLAY="standalone"
NEXT_PUBLIC_PWA_ORIENTATION="portrait"
NEXT_PUBLIC_PWA_BG_COLOR="#080808"
NEXT_PUBLIC_PWA_INSTALL_PROMPT_TITLE="Install Apthex"
NEXT_PUBLIC_PWA_INSTALL_PROMPT_DESC="Add to Home Screen for the best experience"
NEXT_PUBLIC_PWA_ICON_192="/icon-192.png"
NEXT_PUBLIC_PWA_ICON_512="/icon-512.png"
NEXT_PUBLIC_PWA_ICON_MASKABLE_192="/icon-maskable-192.png"
NEXT_PUBLIC_PWA_ICON_MASKABLE_512="/icon-maskable-512.png"
NEXT_PUBLIC_PWA_APPLE_TOUCH_ICON="/apple-icon-180.png"

DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.rjcltz7.mongodb.net/test?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.rjcltz7.mongodb.net/test?retryWrites=true&w=majority"

# Super Admin credentials (plain text in .env — not stored in DB)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change_this_admin_password

# JWT session signing secret (change this in production)
SESSION_SECRET=your_super_secret_jwt_key_here

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Fathom AI Integration
FATHOM_API_KEY=your_fathom_api_key_here
FATHOM_WEBHOOK_SECRET=your_fathom_webhook_secret_here

